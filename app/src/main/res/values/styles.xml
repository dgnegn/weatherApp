<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
<!-- Change parent to the SplashScreen theme -->
<style name="Theme.WeatherApp" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowSplashScreenBackground" tools:targetApi="31">@drawable/ic_launcher_background</item>
    <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/logo</item>
    <item name="android:popupAnimationStyle" tools:targetApi="31" > @style/Theme.WeatherApp.Main</item>
</style>

<style name="Theme.WeatherApp.Main" parent="android:Theme.Material.Light.DarkActionBar">
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
</style>
</resources>
